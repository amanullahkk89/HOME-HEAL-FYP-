# GEMINI_API_KEY: Required for server-side Gemini AI bilingual assistant and TTS calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Maps Platform browser API key (restricted to HTTP referrers and Maps/Routes APIs)
VITE_GOOGLE_MAPS_API_KEY=""

# Database configuration: 'sqlite' (embedded runtime mirror) or 'mysql' (MySQL 8.0)
DB_CLIENT="sqlite"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="homeheal_app"
MYSQL_PASSWORD=""
MYSQL_DATABASE="homeheal_east_city"

# Python FastAPI Haversine nurse matching microservice URL
MATCHING_SERVICE_URL="http://127.0.0.1:8001"

# Firebase Cloud Messaging & Storage (server-side service account for private credentials & push notifications)
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

